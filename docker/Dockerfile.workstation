# ==============================================================================
# SONIC-REDA — Interactive Graphical Desktop Workstation (noVNC + X11)
# ==============================================================================
# Build:  docker build -t sonic-workstation:latest -f docker/Dockerfile.workstation .
#
# Provides the container backing `sonic-desktop-workstation`, the default
# MISSION_COMPUTER for the SONIC control plane (see docker-compose.yml:
# service `workstation`). Matches docker/entrypoint-workstation.sh expectations:
# Xvfb :99 1920x1080, XFCE4 session, x11vnc on 5900, websockify/noVNC
# on 6080. Firefox ESR is installed and opened to a blank tab for visible
# browser-based computer interaction; this does not force a browsing workflow.


ARG WORKSTATION_BASE=debian:12
FROM ${WORKSTATION_BASE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99

# System + desktop + VNC toolchain. Optional packages are tolerated so the
# build succeeds across repo variants (debian bookworm vs trixie).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    procps \
    iproute2 \
    iptables \
    net-tools \
    iputils-ping \
    netcat-openbsd \
    dnsutils \
    jq \
    postgresql-client \
    python3 \
    python3-numpy \
    python3-pil \
    python3-pip \
    python3-venv \
    openjdk-17-jre-headless \
    libnss3-tools \
    xvfb \
    x11vnc \
    xfce4 \
    dbus-x11 \
    x11-utils \
    x11-xserver-utils \
    xdg-utils \
    xdotool \
    wmctrl \
    imagemagick \
    scrot \
    websockify \
    novnc \
    fonts-liberation \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# Bundle only AVCS's pixel-reflex runtime used by SONIC. Keeping these modules
# as a namespace package avoids importing unrelated training/model components.
COPY AVCS/forge/vision/reflex.py /opt/sonic/AVCS/forge/vision/reflex.py
COPY AVCS/forge/vision/scene.py /opt/sonic/AVCS/forge/vision/scene.py
ENV PYTHONPATH=/opt/sonic/AVCS
RUN python3 -c \
    "from forge.vision.reflex import ReflexPerception; import numpy as np; state = ReflexPerception().perceive(np.zeros((16, 16, 3), dtype=np.uint8)); assert (state.width, state.height) == (16, 16)"

RUN useradd --create-home --shell /usr/sbin/nologin sonic-browser

# Ensure python symlink exists for scripts expecting `python`
RUN ln -sf /usr/bin/python3 /usr/local/bin/python

WORKDIR /root
CMD ["tail", "-f", "/dev/null"]